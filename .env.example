# Database Configuration
DB_URL=jdbc:mysql://mysql:3306/hospitaldb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me-local-only
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Security
ADMIN_PASSWORD=change-me-local-only
JWT_SECRET=this-is-a-dummy-jwt-secret-for-local-dev-only-min-32-chars
JWT_EXPIRATION=36000000

# CORS & Cookies
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Rate Limiting
RATE_LIMIT_AUTH_CAPACITY=100
RATE_LIMIT_AUTH_MINUTES=1

# Hibernate
DDL_AUTO=update
SHOW_SQL=false

# Gemini API
GEMINI_API_KEY=dummy-gemini-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Password Reset
MAIL_FROM=onboarding@resend.dev
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000
